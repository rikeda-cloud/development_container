" タブ幅を4に設定
set tabstop=4
set shiftwidth=4
set expandtab

" カーソル行をハイライト
set cursorline

" 検索時にハイライト
set hlsearch
set incsearch

" 保存のショートカット
nnoremap <Space> :w<CR>

inoremap jj <Esc>
nnoremap U <C-r>
nnoremap + <C-a>
nnoremap - <C-x>

nnoremap <Space>h ^
nnoremap <Space>j }
nnoremap <Space>k {
nnoremap <Space>l $